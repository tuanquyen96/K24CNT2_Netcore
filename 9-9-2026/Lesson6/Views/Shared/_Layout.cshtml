<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lesson6</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lesson6.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("VTQHeaderPartialView")
    
    <div class="container">
        <main role="main" class="row pb-3" style="min-height: 550px;">
            <div class="col-md-3">
                @await Component.InvokeAsync("Category")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </main>
    </div>
    @Html.Partial("VTQFooter")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
