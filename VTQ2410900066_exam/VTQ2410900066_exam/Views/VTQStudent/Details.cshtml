@model VTQStudent
@{ ViewData["Title"] = "Chi tiết sinh viên"; }
<h1 class="h2 fw-bold mb-4">Chi tiết sinh viên</h1>
<div class="card border-0 shadow-sm rounded-4 p-4"><dl class="row mb-0"><dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.VTQName</dd><dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@Model.VTQGender</dd><dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.VTQBirthDay.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.VTQEmail</dd><dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@Model.VTQPhone</dd><dt class="col-sm-3">Hoạt động</dt><dd class="col-sm-9">@(Model.VTQActive ? "Có" : "Không")</dd></dl><div class="mt-4"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> <a class="btn btn-light" asp-action="Index">Quay lại</a></div></div>
