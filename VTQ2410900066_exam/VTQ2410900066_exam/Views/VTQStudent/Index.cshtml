@model IEnumerable<VTQStudent>
@{ ViewData["Title"] = "Danh sách sinh viên"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h2 fw-bold mb-1">Danh sách sinh viên</h1><p class="text-muted mb-0">Dữ liệu được truy xuất từ SQL Server.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sinh viên</a>
</div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Họ và tên</th><th>Giới tính</th><th>Ngày sinh</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.VTQName</td><td>@item.VTQGender</td><td>@item.VTQBirthDay.ToString("dd/MM/yyyy")</td><td>@item.VTQEmail</td><td>@item.VTQPhone</td><td>@(item.VTQActive ? "Đang hoạt động" : "Ngừng")</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Xem</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }
</tbody></table></div></div>
