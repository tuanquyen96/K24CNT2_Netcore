@model VTQLab04.Models.VTQMember
@{
    ViewData["Title"] = "VTQEdit";
}
<h1>Edit</h1>
<h4>VTQMember</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="VTQMemberId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="VTQMemberId" class="control-label"></label>
                <input asp-for="VTQMemberId" class="form-control" readonly />
            </div>
            <div class="form-group mb-3">
                <label asp-for="VTQUserName" class="control-label"></label>
                <input asp-for="VTQUserName" class="form-control" />
                <span asp-validation-for="VTQUserName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VTQPassword" class="control-label"></label>
                <input asp-for="VTQPassword" class="form-control" type="password" />
                <span asp-validation-for="VTQPassword" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VTQFullName" class="control-label"></label>
                <input asp-for="VTQFullName" class="form-control" />
                <span asp-validation-for="VTQFullName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="VTQEmail" class="control-label"></label>
                <input asp-for="VTQEmail" class="form-control" />
                <span asp-validation-for="VTQEmail" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Ảnh đại diện</label>
                <input name="AvatarFile" type="file" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div class="mt-2"><a asp-action="Index">Back to List</a></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
