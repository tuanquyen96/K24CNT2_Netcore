@model VTQProduct
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}
<h1>Chỉnh sửa sản phẩm</h1>
<hr />
<form asp-action="Edit" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Image" />
    <div class="row">
        <div class="col-md-7">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Image mới</label>
                <input type="file" name="files" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/Product/@Model.Image" class="mt-2" width="120" alt="@Model.Name" />
                }
            </div>
            <div class="mb-3">
                <label asp-for="Descriptions" class="form-label"></label>
                <textarea asp-for="Descriptions" class="form-control" rows="5"></textarea>
            </div>
        </div>
        <div class="col-md-5">
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SalePrice" class="form-label"></label>
                <input asp-for="SalePrice" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <input asp-for="Status" class="form-control" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-success">Cập nhật</button>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
