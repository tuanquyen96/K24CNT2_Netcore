<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab05</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Account" asp-action="Index">Lab05</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="Account" asp-action="Index">Account</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Create">Thêm mới</a>
                </div>
            </div>
        </nav>
    </header>
    <main class="container pb-4">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
