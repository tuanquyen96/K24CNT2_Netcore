<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Lesson13Layout</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/VTQLayoutHome.css" asp-append-version="true" />
</head>
<body>
    <nav class="container border border-1 my-1">
        <a asp-action="Index" asp-controller="Product">Danh sách sản phẩm</a>
        <a asp-action="Search" asp-controller="Product">Tìm kiếm sản phẩm</a>
        <a asp-action="Hots" asp-controller="Product">Sản phẩm bán chạy</a>
        <a asp-action="Index" asp-controller="Home">Trang chủ</a>
    </nav>

    <div class="container border border-1 my-1">
        @RenderBody()
    </div>

    <footer class="container border border-1 my-1">
        <p style="text-align:center">
            &copy; 10/2026 <br />
            Copyright by @@Tuấn Quyền
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/VTQLayoutHome.js" asp-append-version="true"></script>
</body>
</html>
